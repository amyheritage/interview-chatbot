# Google Gemini API key.
# Get one at https://aistudio.google.com/apikey
#
# WARNING: this build injects the key into the browser bundle at build time
# (see vite.config.ts). Anyone who loads the deployed site can read it.
# Use a throwaway, quota-limited key for demos. Do not use a billing-enabled key.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional. Set to "true" to disable Vite HMR and file watching.
DISABLE_HMR=false
